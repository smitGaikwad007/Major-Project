generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  collectionItems CollectionItem[]
  pdaApplications PdaApplication[]
  auctions        Auction[]         @relation("SellerAuctions")
  bids            Bid[]             @relation("BidderBids")
}

model Stamp {
  id              String            @id @default(uuid())
  name            String
  year            Int
  country         String
  category        String
  description     String
  image           String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  collectionItems CollectionItem[]
  allocations     StampAllocation[]
  auctions        Auction[]
}

model CollectionItem {
  id        String   @id @default(uuid())
  userId    String?
  stampId   String
  quantity  Int      @default(1)
  condition String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  stamp     Stamp    @relation(fields: [stampId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([stampId])
}

model PdaApplication {
  id              String            @id @default(uuid())
  accountNumber   String            @unique
  holderName      String
  postalCircle    String
  balance         Decimal           @default(0) @db.Decimal(12, 2)
  mintStamps      Boolean           @default(true)
  firstDayCovers  Boolean           @default(true)
  miniatureSheets Boolean           @default(false)
  status          String            @default("ACTIVE")
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  allocations     StampAllocation[]

  @@index([userId])
}

model StampAllocation {
  id                String          @id @default(uuid())
  pdaApplicationId  String?
  stampId           String?
  applicantId       Int
  allocatedQuantity Int             @default(1)
  status            String          @default("ALLOTTED")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  pdaApplication    PdaApplication? @relation(fields: [pdaApplicationId], references: [id], onDelete: SetNull)
  stamp             Stamp?          @relation(fields: [stampId], references: [id], onDelete: SetNull)

  @@index([pdaApplicationId])
  @@index([stampId])
  @@index([applicantId])
}

model Auction {
  id            String   @id @default(uuid())
  title         String
  description   String?
  stampId       String?
  sellerId      String?
  sellerName    String
  sellerEmail   String?
  startingPrice Decimal  @db.Decimal(12, 2)
  minIncrement  Decimal  @default(500) @db.Decimal(12, 2)
  currentBid    Decimal? @db.Decimal(12, 2)
  startTime     DateTime
  endTime       DateTime
  status        String   @default("ACTIVE")
  category      String?
  condition     String?
  image         String?
  provenance    String?
  certificate   String?
  winnerId      String?
  winnerName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stamp         Stamp?   @relation(fields: [stampId], references: [id], onDelete: SetNull)
  seller        User?    @relation("SellerAuctions", fields: [sellerId], references: [id], onDelete: SetNull)
  bids          Bid[]

  @@index([sellerId])
  @@index([stampId])
  @@index([status])
}

model Bid {
  id          String   @id @default(uuid())
  auctionId   String
  bidderId    String?
  bidderName  String
  bidderEmail String?
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder      User?    @relation("BidderBids", fields: [bidderId], references: [id], onDelete: SetNull)

  @@index([auctionId])
  @@index([bidderId])
  @@index([createdAt])
}
